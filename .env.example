# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Browser ──────────────────────────────────────────────────────────────────
# Global solve timeout per request in milliseconds
TIMEOUT_MS=120000

# Max concurrent browser contexts (requests) at any time
BROWSER_LIMIT=20

# Pre-warmed context pool size.
# Amendment 11: Default is 1. Each Chromium context uses 300–500MB of RAM.
# You need at least 2GB RAM to set this to 2, 3GB+ for 3.
# On Railway hobby plan (1GB) — keep at 1.
CONTEXT_POOL_SIZE=1

# Run browser in headed (visible) mode — for local debugging only
HEADED=false

# ─── Memory ───────────────────────────────────────────────────────────────────
# Heap usage threshold before memory manager drains the context pool.
# At 1.5x this value, the browser is restarted entirely.
MEMORY_LIMIT_MB=1024

# ─── Jobs ─────────────────────────────────────────────────────────────────────
# How long async jobs are kept before TTL cleanup (milliseconds)
JOB_TTL_MS=300000

# Max requests allowed per /bypass/batch call
BATCH_LIMIT=10

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Proxy pool auto-refreshes every 5 minutes from ProxyScrape v4.
# Countries: HK, KH, TW, KR, VN (Asian DCs outperform Western DCs against CF).
# No configuration needed — pool manages itself.
# To disable proxy pool: leave CONTEXT_POOL_SIZE at 1 and never pass useProxy:true.

# ─── AI / CAPTCHA ─────────────────────────────────────────────────────────────
# Comma-separated Gemini API keys for hCaptcha fallback solver.
# When local @xenova/transformers model fails, keys are rotated round-robin.
# Leave empty to disable Gemini fallback (local model only).
GEMINI_KEYS=

# ─── Paths (set automatically in Dockerfile — override only if running locally) ──
# Where Patchright stores the Chromium binary
PLAYWRIGHT_BROWSERS_PATH=/tmp/pw-browsers

# Where @xenova/transformers caches downloaded models
# Amendment 6: /tmp is RAM-backed tmpfs on Railway — keeps models off disk
TRANSFORMERS_CACHE=/tmp/whisper-cache
